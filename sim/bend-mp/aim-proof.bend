def so.state(+s: S.State, +seat: D.Seat, +t: D.Seat, +shell: D.Shell, +d: D.Damage, +x: Nat) -> S.State:
  S.state.emit(S.state.set_players(s, S.players.set_health(S.state.players(s), t, x)), D.Fired{seat, t, shell, d, Q.subtract(I.seat.health(S.state.players(s), t), x), x})

def so.host(+h: H.Host, +t: D.Seat, +y: Nat) -> H.Host:
  H.host.set_props(h, t, H.props.set_health(H.host.props(h, t), y))

def so.fired(+n: A.Notes(), +seat: D.Seat, +t: D.Seat, +shell: D.Shell, +d: D.Damage, +z: Nat, +y: Nat) -> A.Notes():
  List.append(&2, D.Note, n, [D.Shown{D.Fired{seat, t, shell, d, z, y}}])

