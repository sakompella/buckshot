      +shot : {R.stepped(R.settle(96n, R.answer.move.accepted(aim.ref(S.World{D.Config{table, plan}, before, round, load, first, rh, recipient, turn, direction, died, checking, amount, saw, shell <> rest, shown, deck}, p, g, seat), D.Choice{seat, i, D.Shoot{t}}, True{}))) == A.stepped(S.state.stepped(out)) : A.RefStep()} = U.stepped.ref.local(R.settle(95n, R.RefState{U.hh(st, seat), R.ReceivePacket_Shoot{R.Shot{seat, t, shell, G.damage(saw), List.length(&2, D.Shell, rest)}}, Nil{}}), out, shot.close(shell, D.seat.eq(seat, t), Q.shot.health(shell, I.seat.health(p, t), Q.captured(saw)), table, plan, before, round, load, first, rh, recipient, turn, direction, died, checking, amount, saw, shown, deck, rest, p, g, seat, t, {==}, {==}, shape, seated_t, win))
      Equal.trans(A.RefStep(), R.stepped(R.settle(96n, R.answer.move(aim.ref(S.World{D.Config{table, plan}, before, round, load, first, rh, recipient, turn, direction, died, checking, amount, saw, shell <> rest, shown, deck}, p, g, seat), D.Choice{seat, i, D.Shoot{t}}))), A.stepped(S.state.stepped(out)), A.stepped(S.state.stepped(M.answer.choice(st, D.Choice{seat, i, D.Shoot{t}}))), U.verify.accept(aim.ref(S.World{D.Config{table, plan}, before, round, load, first, rh, recipient, turn, direction, died, checking, amount, saw, shell <> rest, shown, deck}, p, g, seat), D.Choice{seat, i, D.Shoot{t}}, out, U.and.cong_true(R.current.eq(turn, seat), Bool.and(R.props.has_turn(H.host.props(U.hh(st, seat), seat)), True{}), ready, U.and.cong_true(R.props.has_turn(H.host.props(U.hh(st, seat), seat)), True{}, U.held.turn(st, seat, shape, seated), {==})), shot), Equal.cong(Maybe<&2, S.TargetOption>, A.RefStep(), o => A.stepped(S.state.stepped(M.aim.selected(st, seat, o))), Some{S.Target{t}}, Q.target.nth(Q.aim.targets(p), i), Equal.sym(Maybe<&2, S.TargetOption>, Q.target.nth(Q.aim.targets(p), i), Some{S.Target{t}}, sel)))
