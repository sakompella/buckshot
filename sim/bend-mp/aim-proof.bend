# The Aim menu: a resolved choice shoots a living seat, which is seated.

def AimSel(+targets: List<&2, S.TargetOption>, +i: Nat, +m: D.Move) -> Data:
  match m:
    case D.Shoot{+t}:
      {Q.target.nth(targets, i) == Some{S.Target{t}} : Maybe<&2, S.TargetOption>}
    case _:
      Empty

def aim.sel.tail(+o: S.TargetOption, +os: List<&2, S.TargetOption>, +j: Nat, +m: D.Move, +sel: AimSel(os, j, m)) -> AimSel(o <> os, 1n+j, m):
  match m:
    case D.Shoot{+t}:
      sel
    case D.PickUp{}:
      match sel:
    case D.UseItem{a, b}:
      match sel:
    case D.Grab{}:
      match sel:
    case D.Place{x}:
      match sel:
    case D.JamTarget{x}:
      match sel:
    case D.Steal{a, b, c}:
      match sel:

def aim.sel(+targets: List<&2, S.TargetOption>, +i: Nat, +m: D.Move, +e: {Q.nth(D.Move, Q.aim.moves(targets), i) == Some{m} : Maybe<&2, D.Move>}) -> AimSel(targets, i, m):
  match targets i:
    case Nil{} i:
      GP.absurd(AimSel(Nil{}, i, m), U.none.some(m, e))
    case S.Target{+t} <> +os 0n:
      %U.some.inj(D.Move, D.Shoot{t}, m, e) : AimSel(S.Target{t} <> os, 0n, _)
      {==}
    case S.Target{+t} <> +os 1n+j:
      aim.sel.tail(S.Target{t}, os, j, m, aim.sel(os, j, m, e))

def AllSeated(+table: D.Table, +es: List<&2, D.At<&2, Nat>>) -> Data:
  match es:
    case Nil{}:
      Unit
    case D.At{+s, _} <> +rest:
      Sigma<&2, &2, P.seated(table, s), _ => AllSeated(table, rest)>

def tgt.none(+m: Maybe<&2, S.TargetOption>) -> Type:
  match m:
    case None{}:
      Empty
    case Some{x}:
      Unit

def tgt.clash(+t: D.Seat, +e: {None{} == Some{S.Target{t}} : Maybe<&2, S.TargetOption>}) -> Empty:
  %Equal.sym(Maybe<&2, S.TargetOption>, None{}, Some{S.Target{t}}, e) : tgt.none(_)
  Unit{}

def tgt.seat(+m: Maybe<&2, S.TargetOption>) -> D.Seat:
  match m:
    case Some{S.Target{t}}:
      t
    case None{}:
      D.Seat0{}

def targets.mem(+table: D.Table, +es: List<&2, D.At<&2, Nat>>, +i: Nat, +t: D.Seat, +all: AllSeated(table, es), +e: {Q.target.nth(Q.targets(es), i) == Some{S.Target{t}} : Maybe<&2, S.TargetOption>}) -> P.seated(table, t):
  match es i:
    case Nil{} i:
      GP.absurd(P.seated(table, t), tgt.clash(t, e))
    case D.At{+s, 0n} <> +rest i:
      match all:
        case Tuple{_, +more}:
          targets.mem(table, rest, i, t, more, e)
    case D.At{+s, 1n+h} <> +rest 0n:
      match all:
        case Tuple{+here, _}:
          %Equal.cong(Maybe<&2, S.TargetOption>, D.Seat, o => tgt.seat(o), Some{S.Target{s}}, Some{S.Target{t}}, e) : P.seated(table, _)
          here
    case D.At{+s, 1n+h} <> +rest 1n+j:
      match all:
        case Tuple{_, +more}:
          targets.mem(table, rest, j, t, more, e)

def seated.claim(+s: S.State) -> Type:
  AllSeated(S.world.table(S.state.world(s)), D.ring.entries(Nat, S.players.health(S.state.players(s))))

def entries.seated(+s: S.State, +shape: A.Shape(s)) -> seated.claim(s):
  match s:
    case S.State{S.World{D.Config{table, +plan}, +before, +round, +load, +first, +rh, +recipient, +turn, +direction, +died, +checking, +amount, +saw, +gun, +shown, +deck}, players, +phase, +notes, grabs}:
      match table players grabs:
        case D.TwoSeats{} D.Duo{S.Seat{+h1, +j1, +c1, +s1}, S.Seat{+h3, +j3, +c3, +s3}} S.Grabs{+dist, +grabbing, +holding, +granted, +intake}:
          (Unit{}, (Unit{}, Unit{}))
        case D.TwoSeats{} D.Trio{S.Seat{+h0, +j0, +c0, +s0}, S.Seat{+h1, +j1, +c1, +s1}, S.Seat{+h2, +j2, +c2, +s2}} S.Grabs{+dist, +grabbing, +holding, +granted, +intake}:
          match shape:
            case Tuple{e_players, Tuple{e_grabbing, Tuple{e_holding, Tuple{e_granted, e_intake}}}}:
              GP.absurd(seated.claim(S.State{S.World{D.Config{D.TwoSeats{}, plan}, before, round, load, first, rh, recipient, turn, direction, died, checking, amount, saw, gun, shown, deck}, D.Trio{S.Seat{h0, j0, c0, s0}, S.Seat{h1, j1, c1, s1}, S.Seat{h2, j2, c2, s2}}, phase, notes, S.Grabs{dist, grabbing, holding, granted, intake}}), GP.clash.three_two(e_players))
        case D.TwoSeats{} D.Quad{S.Seat{+h0, +j0, +c0, +s0}, S.Seat{+h1, +j1, +c1, +s1}, S.Seat{+h2, +j2, +c2, +s2}, S.Seat{+h3, +j3, +c3, +s3}} S.Grabs{+dist, +grabbing, +holding, +granted, +intake}:
          match shape:
            case Tuple{e_players, Tuple{e_grabbing, Tuple{e_holding, Tuple{e_granted, e_intake}}}}:
              GP.absurd(seated.claim(S.State{S.World{D.Config{D.TwoSeats{}, plan}, before, round, load, first, rh, recipient, turn, direction, died, checking, amount, saw, gun, shown, deck}, D.Quad{S.Seat{h0, j0, c0, s0}, S.Seat{h1, j1, c1, s1}, S.Seat{h2, j2, c2, s2}, S.Seat{h3, j3, c3, s3}}, phase, notes, S.Grabs{dist, grabbing, holding, granted, intake}}), GP.clash.four_two(e_players))
        case D.ThreeSeats{} D.Trio{S.Seat{+h0, +j0, +c0, +s0}, S.Seat{+h1, +j1, +c1, +s1}, S.Seat{+h2, +j2, +c2, +s2}} S.Grabs{+dist, +grabbing, +holding, +granted, +intake}:
          (Unit{}, (Unit{}, (Unit{}, Unit{})))
        case D.ThreeSeats{} D.Duo{S.Seat{+h1, +j1, +c1, +s1}, S.Seat{+h3, +j3, +c3, +s3}} S.Grabs{+dist, +grabbing, +holding, +granted, +intake}:
          match shape:
            case Tuple{e_players, Tuple{e_grabbing, Tuple{e_holding, Tuple{e_granted, e_intake}}}}:
              GP.absurd(seated.claim(S.State{S.World{D.Config{D.ThreeSeats{}, plan}, before, round, load, first, rh, recipient, turn, direction, died, checking, amount, saw, gun, shown, deck}, D.Duo{S.Seat{h1, j1, c1, s1}, S.Seat{h3, j3, c3, s3}}, phase, notes, S.Grabs{dist, grabbing, holding, granted, intake}}), GP.clash.two_three(e_players))
        case D.ThreeSeats{} D.Quad{S.Seat{+h0, +j0, +c0, +s0}, S.Seat{+h1, +j1, +c1, +s1}, S.Seat{+h2, +j2, +c2, +s2}, S.Seat{+h3, +j3, +c3, +s3}} S.Grabs{+dist, +grabbing, +holding, +granted, +intake}:
          match shape:
            case Tuple{e_players, Tuple{e_grabbing, Tuple{e_holding, Tuple{e_granted, e_intake}}}}:
              GP.absurd(seated.claim(S.State{S.World{D.Config{D.ThreeSeats{}, plan}, before, round, load, first, rh, recipient, turn, direction, died, checking, amount, saw, gun, shown, deck}, D.Quad{S.Seat{h0, j0, c0, s0}, S.Seat{h1, j1, c1, s1}, S.Seat{h2, j2, c2, s2}, S.Seat{h3, j3, c3, s3}}, phase, notes, S.Grabs{dist, grabbing, holding, granted, intake}}), GP.clash.four_three(e_players))
        case D.FourSeats{} D.Quad{S.Seat{+h0, +j0, +c0, +s0}, S.Seat{+h1, +j1, +c1, +s1}, S.Seat{+h2, +j2, +c2, +s2}, S.Seat{+h3, +j3, +c3, +s3}} S.Grabs{+dist, +grabbing, +holding, +granted, +intake}:
          (Unit{}, (Unit{}, (Unit{}, (Unit{}, Unit{}))))
        case D.FourSeats{} D.Duo{S.Seat{+h1, +j1, +c1, +s1}, S.Seat{+h3, +j3, +c3, +s3}} S.Grabs{+dist, +grabbing, +holding, +granted, +intake}:
          match shape:
            case Tuple{e_players, Tuple{e_grabbing, Tuple{e_holding, Tuple{e_granted, e_intake}}}}:
              GP.absurd(seated.claim(S.State{S.World{D.Config{D.FourSeats{}, plan}, before, round, load, first, rh, recipient, turn, direction, died, checking, amount, saw, gun, shown, deck}, D.Duo{S.Seat{h1, j1, c1, s1}, S.Seat{h3, j3, c3, s3}}, phase, notes, S.Grabs{dist, grabbing, holding, granted, intake}}), GP.clash.two_four(e_players))
        case D.FourSeats{} D.Trio{S.Seat{+h0, +j0, +c0, +s0}, S.Seat{+h1, +j1, +c1, +s1}, S.Seat{+h2, +j2, +c2, +s2}} S.Grabs{+dist, +grabbing, +holding, +granted, +intake}:
          match shape:
            case Tuple{e_players, Tuple{e_grabbing, Tuple{e_holding, Tuple{e_granted, e_intake}}}}:
              GP.absurd(seated.claim(S.State{S.World{D.Config{D.FourSeats{}, plan}, before, round, load, first, rh, recipient, turn, direction, died, checking, amount, saw, gun, shown, deck}, D.Trio{S.Seat{h0, j0, c0, s0}, S.Seat{h1, j1, c1, s1}, S.Seat{h2, j2, c2, s2}}, phase, notes, S.Grabs{dist, grabbing, holding, granted, intake}}), GP.clash.three_four(e_players))

def aim.at(+w: S.World, +p: S.Players, +seat: D.Seat, +n: A.Notes(), +g: S.Grabs) -> S.State:
  S.State{w, p, S.Aim{seat}, n, g}

def aim.moves(+p: S.Players) -> List<&2, D.Move>:
  Q.aim.moves(Q.aim.targets(p))

def aim.ref(+w: S.World, +p: S.Players, +g: S.Grabs, +seat: D.Seat) -> R.RefState:
  R.RefState{U.hh(aim.at(w, p, seat, Nil{}, g), seat), R.Await{D.Choose{U.menu.of(S.world.table(w), seat, aim.moves(p))}, D.Playing{seat, D.Aiming{}}, R.PlayerMove{D.Aiming{}}}, Nil{}}

