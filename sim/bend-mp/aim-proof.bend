def aim.answer(+w: S.World, +p: S.Players, +seat: D.Seat, +n0: A.Notes(), +g: S.Grabs, +n: Nat, +shape: A.Shape(aim.at(w, p, seat, n0, g)), +ready: {R.current.eq(S.world.turn(w), seat) == True{} : Bool}, win: T.WinClosure()) -> {A.ref_answer(A.ref(aim.at(w, p, seat, n0, g)), n) == A.stepped(M.answer(aim.at(w, p, seat, n0, g), n)) : A.RefStep()}:
  match w:
    case S.World{D.Config{+table, +plan}, +before, +round, +load, +first, +rh, +recipient, +turn, +direction, +died, +checking, +amount, +saw, +gun, +shown, +deck}:
      +st : S.State = aim.at(S.World{D.Config{table, plan}, before, round, load, first, rh, recipient, turn, direction, died, checking, amount, saw, gun, shown, deck}, p, seat, n0, g)
      +h : H.Host = U.hh(st, seat)
      +moves_r : List<&2, D.Move> = R.shot_moves(G.living(D.ring.entries(H.Props, H.host.seats(h))))
      +moved : {R.answer(R.RefState{h, A.idle.frame(h, seat, D.Aiming{}, moves_r), n0}, n) == R.answer(R.RefState{h, A.idle.frame(h, seat, D.Aiming{}, aim.moves(p)), n0}, n) : A.RefStep()} = Equal.cong(List<&2, D.Move>, A.RefStep(), xs => R.answer(R.RefState{h, A.idle.frame(h, seat, D.Aiming{}, xs), n0}, n), moves_r, aim.moves(p), Equal.sym(List<&2, D.Move>, aim.moves(p), moves_r, ISP.aim.eq(st, shape)))
