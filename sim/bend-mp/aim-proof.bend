def damage.eq(+b: Bool) -> {G.damage(b) == Q.captured(b) : D.Damage}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

def same.passes(+shell: D.Shell, +a: Bool, +b: Bool, +e: {a == b : Bool}) -> {Bool.not(Bool.and(a, Bool.not(G.shell.live(shell)))) == Q.shot.passes(shell, b) : Bool}:
  Equal.trans(Bool, Bool.not(Bool.and(a, Bool.not(G.shell.live(shell)))), Bool.not(Bool.and(b, Bool.not(G.shell.live(shell)))), Q.shot.passes(shell, b), Equal.cong(Bool, Bool, x => Bool.not(Bool.and(x, Bool.not(G.shell.live(shell)))), a, b, e), Equal.sym(Bool, Q.shot.passes(shell, b), A.ref_shot_passes(shell, b), SP.passes_matches(shell, b)))

# CheckIfEndingTurn: the end packet in the machine's terms, then the turn end.
def ciet.close(+s: S.State, +seat: D.Seat, +t: D.Seat, +shell: D.Shell, +d: D.Damage, +same: Bool, +e_same: {D.seat.eq(seat, t) == same : Bool}, +k: Nat, +shape: A.Shape(s), win: T.WinClosure()) -> {R.settle(Nat.add(26n, k), R.RefState{T.qh(s), R.CheckIfEndingTurn{R.Shot{seat, t, shell, d, List.length(&2, D.Shell, S.world.gun(S.state.world(s)))}}, S.state.notes(s)}) == A.ref(M.turn.packet(s, seat, Q.shot.passes(shell, same), Q.winner(S.players.health(S.state.players(s))))) : R.RefState}:
  match s:
    case S.State{S.World{D.Config{+table, +plan}, +before, +round, +load, +first, +rh, +recipient, +turn, +direction, +died, +checking, +amount, +saw, +gun, +shown, +deck}, +p, +ph, +n, +g}:
      +st : S.State = S.State{S.World{D.Config{table, plan}, before, round, load, first, rh, recipient, turn, direction, died, checking, amount, saw, gun, shown, deck}, p, ph, n, g}
      +empty : Bool = Nat.is_eq(List.length(&2, D.Shell, gun), 0n)
      +pass_r : Bool = Bool.not(Bool.and(D.seat.eq(seat, t), Bool.not(G.shell.live(shell))))
      +pass_m : Bool = Q.shot.passes(shell, same)
      +win_r : Maybe<&2, D.Seat> = G.CheckIfUserHasWon(T.qh(st))
      +win_m : Maybe<&2, D.Seat> = Q.winner(S.players.health(p))
      +e1 : {R.settle(Nat.add(25n, k), R.RefState{T.qh(st), R.UserEndTurn_Packet{R.EndPacket{seat, pass_r, empty, win_r}}, n}) == R.settle(Nat.add(25n, k), R.RefState{T.qh(st), R.UserEndTurn_Packet{R.EndPacket{seat, pass_m, empty, win_r}}, n}) : R.RefState} = Equal.cong(Bool, R.RefState, b => R.settle(Nat.add(25n, k), R.RefState{T.qh(st), R.UserEndTurn_Packet{R.EndPacket{seat, b, empty, win_r}}, n}), pass_r, pass_m, same.passes(shell, D.seat.eq(seat, t), same, e_same))
      +e2 : {R.settle(Nat.add(25n, k), R.RefState{T.qh(st), R.UserEndTurn_Packet{R.EndPacket{seat, pass_m, empty, win_r}}, n}) == R.settle(Nat.add(25n, k), R.RefState{T.qh(st), R.UserEndTurn_Packet{R.EndPacket{seat, pass_m, empty, win_m}}, n}) : R.RefState} = Equal.cong(Maybe<&2, D.Seat>, R.RefState, x => R.settle(Nat.add(25n, k), R.RefState{T.qh(st), R.UserEndTurn_Packet{R.EndPacket{seat, pass_m, empty, x}}, n}), win_r, win_m, winner.eq(S.State{S.World{D.Config{table, plan}, before, round, load, first, rh, recipient, turn, direction, died, checking, amount, saw, gun, shown, deck}, p, S.Blocked{None{}}, n, g}, ISP.shape.move(S.World{D.Config{table, plan}, before, round, load, first, rh, recipient, turn, direction, died, checking, amount, saw, gun, shown, deck}, p, ph, n, g, S.Blocked{None{}}, n, shape)))
      Equal.trans(R.RefState, R.settle(Nat.add(25n, k), R.RefState{T.qh(st), R.UserEndTurn_Packet{R.EndPacket{seat, pass_r, empty, win_r}}, n}), R.settle(Nat.add(25n, k), R.RefState{T.qh(st), R.UserEndTurn_Packet{R.EndPacket{seat, pass_m, empty, win_r}}, n}), A.ref(M.turn.packet(st, seat, pass_m, win_m)), e1, Equal.trans(R.RefState, R.settle(Nat.add(25n, k), R.RefState{T.qh(st), R.UserEndTurn_Packet{R.EndPacket{seat, pass_m, empty, win_r}}, n}), R.settle(Nat.add(25n, k), R.RefState{T.qh(st), R.UserEndTurn_Packet{R.EndPacket{seat, pass_m, empty, win_m}}, n}), A.ref(M.turn.packet(st, seat, pass_m, win_m)), e2, T.packet.close(st, seat, pass_m, win_m, k, shape, win)))

def tail.state(+s: S.State, +saw: Bool) -> S.State:
  S.state.set_world(s, S.world.set_sawed(S.world.set_gun(S.state.world(s), R.gun.tail(S.world.gun(S.state.world(s)))), saw))

def shape.world(+w: S.World, +w2: S.World, +p: S.Players, +ph: S.Phase, +n: A.Notes(), +g: S.Grabs, +e: {S.world.table(w2) == S.world.table(w) : D.Table}, +shape: A.Shape(S.State{w, p, ph, n, g})) -> A.Shape(S.State{w2, p, ph, n, g}):
  match g:
    case S.Grabs{+dist, +grabbing, +holding, +granted, +intake}:
      match shape:
        case Tuple{+e_p, Tuple{+e_g, Tuple{+e_h, Tuple{+e_n, +e_i}}}}:
          (Equal.trans(D.Table, D.ring.table(S.Seat, p), S.world.table(w), S.world.table(w2), e_p, Equal.sym(D.Table, S.world.table(w2), S.world.table(w), e)), (Equal.trans(D.Table, D.ring.table(Bool, grabbing), S.world.table(w), S.world.table(w2), e_g, Equal.sym(D.Table, S.world.table(w2), S.world.table(w), e)), (Equal.trans(D.Table, D.ring.table(Maybe<&2, D.Item>, holding), S.world.table(w), S.world.table(w2), e_h, Equal.sym(D.Table, S.world.table(w2), S.world.table(w), e)), (Equal.trans(D.Table, D.ring.table(Nat, granted), S.world.table(w), S.world.table(w2), e_n, Equal.sym(D.Table, S.world.table(w2), S.world.table(w), e)), Equal.trans(D.Table, D.ring.table(Bool, intake), S.world.table(w), S.world.table(w2), e_i, Equal.sym(D.Table, S.world.table(w2), S.world.table(w), e))))))

# RemoveFirstShellFromSequence and the barrel growing back, then
# CheckIfEndingTurn. A self shot with a live shell grew the barrel before.
def tail.grow(+shell: D.Shell, +same: Bool, +s: S.State, +seat: D.Seat, +t: D.Seat, +d: D.Damage, +k: Nat, +e_same: {D.seat.eq(seat, t) == same : Bool}, +grows: {Bool.and(G.shell.live(shell), same) == False{} : Bool}, +shape: A.Shape(s), win: T.WinClosure()) -> {R.settle(Nat.add(28n, k), R.RefState{T.qh(s), R.RemoveFirstShellFromSequence{R.Shot{seat, t, shell, d, List.length(&2, D.Shell, R.gun.tail(S.world.gun(S.state.world(s))))}}, S.state.notes(s)}) == A.ref(M.turn.packet(tail.state(s, False{}), seat, Q.shot.passes(shell, same), Q.winner(S.players.health(S.state.players(s))))) : R.RefState}:
  match shell same:
    case D.Blank{} same:
      match s:
        case S.State{S.World{D.Config{+table, +plan}, +before, +round, +load, +first, +rh, +recipient, +turn, +direction, +died, +checking, +amount, +saw, +gun, +shown, +deck}, +p, +ph, +n, +g}:
          ciet.close(S.State{S.World{D.Config{table, plan}, before, round, load, first, rh, recipient, turn, direction, died, checking, amount, False{}, R.gun.tail(gun), shown, deck}, p, ph, n, g}, seat, t, D.Blank{}, d, same, e_same, k, shape.world(S.World{D.Config{table, plan}, before, round, load, first, rh, recipient, turn, direction, died, checking, amount, saw, gun, shown, deck}, S.World{D.Config{table, plan}, before, round, load, first, rh, recipient, turn, direction, died, checking, amount, False{}, R.gun.tail(gun), shown, deck}, p, ph, n, g, {==}, shape), win)
    case D.Live{} False{}:
      match s:
        case S.State{S.World{D.Config{+table, +plan}, +before, +round, +load, +first, +rh, +recipient, +turn, +direction, +died, +checking, +amount, +saw, +gun, +shown, +deck}, +p, +ph, +n, +g}:
