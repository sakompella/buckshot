def valid.swap.answer(+w: S.World, +p: S.Players, +ld: D.Load, +sh: List<&2, D.Shell>, +e: Nat, +n0: A.Notes(), +g: S.Grabs, +n: Nat, +valid: A.Valid(S.State{w, p, S.NeedSwap{ld, sh, 1n+e}, n0, g})) -> A.Valid(A.next(S.State{w, p, S.NeedSwap{ld, sh, 1n+e}, n0, g}, n)):
  match valid:
    case Tuple{+normal, Tuple{+shape, Tuple{+bounded, +ready}}}:
      LP.valid.shuffle(e, S.State{w, p, S.NeedSwap{ld, sh, 1n+e}, Nil{}, g}, ld, Q.swap(sh, 1n+e, D.draw.value(D.Range{0n, e}, n)), (ISP.shape.move(w, p, S.NeedSwap{ld, sh, 1n+e}, n0, g, S.NeedSwap{ld, sh, 1n+e}, Nil{}, shape), bounded))

# step_matches at NeedBatch with items.
def step.batch(+world: S.World, +players: S.Players, +notes: A.Notes(), +grabs: S.Grabs, +n: Nat, +valid: A.Valid(S.State{world, players, S.NeedBatch{}, notes, grabs})) -> A.Simulation(S.State{world, players, S.NeedBatch{}, notes, grabs}, n):
  ISP.simulation.items(S.State{world, players, S.NeedBatch{}, notes, grabs}, n, batch.answer(world, players, notes, grabs, n, A.valid.shape(S.State{world, players, S.NeedBatch{}, notes, grabs}, valid)), valid.batch.answer(world, players, notes, grabs, n, valid))

