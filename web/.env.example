# Arena agents A to D (C and D like A and B): each uses either the Anthropic Messages API (ANT) or the OpenAI Responses API (OAI), not both.
# Agent A's Anthropic base URL; the SDK appends /v1/messages.
PLAYER_A_ANT_URL=http://127.0.0.1:8318
# Agent A's Anthropic API key.
PLAYER_A_ANT_KEY=replace-me
# Agent A's OpenAI Responses base URL, ending in /v1; set instead of the two ANT variables.
# PLAYER_A_OAI_URL=http://127.0.0.1:8318/v1
# Agent A's OpenAI API key, with PLAYER_A_OAI_URL.
# PLAYER_A_OAI_KEY=replace-me
# Agent A's model id, as the endpoint names it.
PLAYER_A_MODEL=claude-haiku-5-5
# The pi-ai catalog model that PLAYER_A_MODEL stands for, when pi-ai does not list PLAYER_A_MODEL itself,
# such as a proxy's gpt-6-luna-fast (gpt-6-luna). Its context window, thinking levels and prices apply. Optional.
# PLAYER_A_CATALOG_MODEL=gpt-6-luna
# Agent A's reasoning effort: off, minimal, low, medium, high, xhigh or max. Optional.
PLAYER_A_EFFORT=medium
# Agent B's Anthropic base URL; set instead of the two OAI variables.
# PLAYER_B_ANT_URL=http://127.0.0.1:8318
# Agent B's Anthropic API key, with PLAYER_B_ANT_URL.
# PLAYER_B_ANT_KEY=replace-me
# Agent B's OpenAI Responses base URL, ending in /v1.
PLAYER_B_OAI_URL=http://127.0.0.1:8318/v1
# Agent B's OpenAI API key.
PLAYER_B_OAI_KEY=replace-me
# Agent B's model id, as pi-ai's catalog for that API names it.
PLAYER_B_MODEL=gpt-6-luna
# Agent B's reasoning effort. Optional.
PLAYER_B_EFFORT=medium
# Optional: PLAYER_A_ACCOUNT_ID pins every request of agent A to one account of a proxy, sent in the header ARENA_ACCOUNT_HEADER names.
# A tournament endpoint's `accounts` sets PLAYER_<letter>_ACCOUNT_ID for each match.
# ARENA_ACCOUNT_HEADER=X-Account-Id
# PLAYER_A_ACCOUNT_ID=account-1
# The keys that web/tournaments/example.json names as keyEnv. Only scripts/arena-tournament.ts reads them, and hands each to a match as PLAYER_<letter>_*_KEY.
ANTHROPIC_API_KEY=replace-me
OPENAI_API_KEY=replace-me
