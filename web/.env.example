# Arena players: each player uses either the Anthropic Messages API (ANT) or the OpenAI Responses API (OAI), not both.
# Player 1's Anthropic base URL; the SDK appends /v1/messages.
PLAYER_ONE_ANT_URL=http://127.0.0.1:8318
# Player 1's Anthropic API key.
PLAYER_ONE_ANT_KEY=replace-me
# Player 1's OpenAI Responses base URL, ending in /v1; set instead of the two ANT variables.
# PLAYER_ONE_OAI_URL=http://127.0.0.1:8318/v1
# Player 1's OpenAI API key, with PLAYER_ONE_OAI_URL.
# PLAYER_ONE_OAI_KEY=replace-me
# Player 1's model id, as pi-ai's catalog for that API names it.
PLAYER_ONE_MODEL=claude-haiku-5-5
# Player 1's reasoning effort: off, minimal, low, medium, high, xhigh or max. Optional.
PLAYER_ONE_EFFORT=medium
# Player 2's Anthropic base URL; set instead of the two OAI variables.
# PLAYER_TWO_ANT_URL=http://127.0.0.1:8318
# Player 2's Anthropic API key, with PLAYER_TWO_ANT_URL.
# PLAYER_TWO_ANT_KEY=replace-me
# Player 2's OpenAI Responses base URL, ending in /v1.
PLAYER_TWO_OAI_URL=http://127.0.0.1:8318/v1
# Player 2's OpenAI API key.
PLAYER_TWO_OAI_KEY=replace-me
# Player 2's model id, as pi-ai's catalog for that API names it.
PLAYER_TWO_MODEL=gpt-6-luna
# Player 2's reasoning effort. Optional.
PLAYER_TWO_EFFORT=medium
