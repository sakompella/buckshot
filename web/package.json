    "@fontsource/vt323": "5.3.0",
    "effect": "4.0.0",
    "foldkit": "0.167.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@foldkit/vite-plugin": "0.27.1",
    "@oxlint/plugins": "1.87.0",
    "@types/bun": "1.4.2",
    "@types/three": "0.186.0",
    "oxlint": "1.87.0",
