{
  "name": "buckshot-web",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "@effect/platform-browser": "4.1.4",
    "@modelcontextprotocol/server": "2.4.0",
    "effect": "4.1.4",
    "foldkit": "0.171.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.1",
    "@effect/tsgo": "0.73.2",
    "@foldkit/vite-plugin": "0.29.1",
    "@hegeldev/hegel": "0.5.9",
    "@modelcontextprotocol/client": "2.4.0",
    "@oxlint/plugins": "1.94.0",
    "@types/bun": "1.4.4",
    "cf": "1.0.0-rc.1",
    "oxlint": "1.94.0",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "vite": "8.3.8"
  },
  "scripts": {
    "rules": "bun scripts/build-rules.ts",
    "dev": "bun run rules && vite --port 5173 --strictPort",
    "build": "bun run rules && vite build",
    "lint": "oxlint --type-aware --deny-warnings",
    "typecheck": "effect-tsgo tsrs --noEmit -p .",
    "test": "bun run rules && BUCKSHOT_CODE=test bun test ./test --timeout 60000",
    "test:lint-rules": "node --experimental-strip-types --test 'tools/oxlint/anti-slop/**/*.test.ts'",
    "mcp": "bun run rules 1>&2 && bun scripts/mcp.ts",
    "dev:online": "bun run rules && cf dev --mode online",
    "og-image": "bun scripts/og-image.ts",
    "build:online": "bun run rules && cf build --mode online",
    "deploy:online": "bun run rules && bun scripts/deploy-online.ts check && cf deploy --mode online",
    "deploy:preview": "bun run rules && bun scripts/deploy-online.ts preview",
    "deploy:promote": "bun scripts/deploy-online.ts promote"
  }
}
