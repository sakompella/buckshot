{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        // Suggestions fail typecheck too: every rule on by default is enforced.
        "ignoreEffectSuggestionsInTscExitCode": false,
        // The site's and the deploy script's fetch client; Effect 4 marks it unstable.
        "allowedUnstableApis": ["effect/http/HttpClient", "effect/http/HttpClientResponse", "effect/http/HttpClientRequest", "effect/http/FetchHttpClient"],
        // Rules off by default are turned on here, except the Effect style rules this code does not follow (preferEffectArray, globalJson, asyncFunction, ...).
        "diagnosticSeverity": {
          "anyUnknownInErrorContext": "error",
          "apiStabilityLeak": "error",
          "cryptoRandomUUID": "error",
          "cryptoRandomUUIDInEffect": "error",
          "deterministicKeys": "error",
          "effectDoNotation": "error",
          "effectTryWithoutCatch": "error",
          "extendsNativeError": "error",
          "forLoopPushToForEach": "error",
          "globalConsoleInEffect": "error",
          "globalDateInEffect": "error",
          "globalFetch": "error",
          "globalFetchInEffect": "error",
          "globalJsonInEffect": "error",
          "globalRandom": "error",
          "globalRandomInEffect": "error",
          "globalTimers": "error",
          "globalTimersInEffect": "error",
          "instanceOfSchema": "error",
          "mapMapErrorToMapBoth": "error",
          "missedPipeableOpportunity": "error",
          "missingConcurrencyOption": "error",
          "missingEffectServiceDependency": "error",
          "nestedEffectGenYield": "error",
          "newPromise": "error",
          "newSchemaClass": "error",
          "preferBarrelImport": "error",
          "preferNamespaceImport": "error",
          "preferSchemaTaggedError": "error",
          "preferSchemaTypeProperty": "error",
          "processEnvInEffect": "error",
          "promiseAllInEffect": "error",
          "promiseRaceInEffect": "error",
          "provideMergeAllToArray": "error",
          "schemaUnionOfLiterals": "error",
          "serviceNotAsClass": "error",
          "strictEffectProvide": "error",
          "typeUnionToSchemaUnion": "error",
          "unnecessaryArrowBlock": "error",
          "unsafeEffectTypeAssertion": "error",
          "yieldInCallArgument": "error"
        }
      }
    ]
  },
  "include": ["src", "scripts", "test", "generated/*.d.mts", "oxlint.config.ts", "vite.config.ts", "cloudflare.config.ts"],
  "exclude": ["tools"]
}
