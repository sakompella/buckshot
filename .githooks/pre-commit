#!/usr/bin/env bash
# Pre-commit checks for the Rust workspace (sim/rust). Skipped when no file
# under sim/rust/ is staged. Checks the working tree, not only the staged
# content. `nix develop` sets core.hooksPath to .githooks when it is unset.
set -uo pipefail

if git diff --cached --quiet -- sim/rust; then
  exit 0
fi

root=$(git rev-parse --show-toplevel)
cd "$root/sim/rust" || exit 1
run() {
  # A rustup shim may be on PATH without a toolchain; trust only the dev shell's cargo.
  if [[ -n ${IN_NIX_SHELL:-} ]]; then nice -n 10 "$@"; else nice -n 10 nix develop "$root" -c "$@"; fi
}

failed=()
check() {
  echo "pre-commit: $*"
  run "$@" || failed+=("$*")
}
check cargo fmt --all --check
# shellcheck source=../sim/rust/features.sh
source "$root/sim/rust/features.sh"
for features in "${feature_sets[@]}"; do
  # shellcheck disable=SC2086
  check cargo clippy --workspace --all-targets $features -- -D warnings
done
# The sets above name every feature; this checks the defaults name one of them.
check cargo check --workspace --all-targets
check cargo branch-map check

if ((${#failed[@]})); then
  echo "pre-commit: failed (run from sim/rust/):" >&2
  printf '  %s\n' "${failed[@]}" >&2
  exit 1
fi
