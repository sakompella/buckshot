#!/usr/bin/env bash
# Pre-commit checks for the Rust workspace (sim/rust). Skipped when no file
# under sim/rust/ is staged. Checks the working tree, not only the staged
# content. `nix develop` points core.hooksPath here.
set -uo pipefail

if git diff --cached --quiet -- sim/rust; then
  exit 0
fi

root=$(git rev-parse --show-toplevel)
cd "$root/sim/rust" || exit 1
run() {
  if command -v cargo >/dev/null; then nice -n 10 "$@"; else nice -n 10 nix develop "$root" -c "$@"; fi
}

failed=()
check() {
  echo "pre-commit: $*"
  run "$@" || failed+=("$*")
}
check cargo fmt --all --check
# Every valid feature set, never --all-features: buckshot-search's `f64`
# (default) and `f32` exclude each other, and buckshot-rules' `trace`
# changes what `branch!` expands to.
for features in "" "--features buckshot-rules/trace" \
  "--no-default-features --features f32" "--no-default-features --features f32,buckshot-rules/trace"; do
  # shellcheck disable=SC2086
  check cargo clippy --workspace --all-targets $features -- -D warnings
done
check cargo check --workspace --all-targets
check cargo check --workspace --all-targets --no-default-features --features f32

if ((${#failed[@]})); then
  echo "pre-commit: failed (run from sim/rust/):" >&2
  printf '  %s\n' "${failed[@]}" >&2
  exit 1
fi
